# Copy to .env and fill in. .env is ignored by git.
# Add the password after "postgres" if your PostgreSQL needs one: postgresql+psycopg://postgres:PASSWORD@localhost:5432/keyfive_wms
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/keyfive_wms
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# First admin, created automatically on the first start
ADMIN_EMAIL=Admin001@wms.kz
ADMIN_PASSWORD=
# Password of all demo users (python -m app.seed --demo)
DEMO_PASSWORD=
APP_TIMEZONE=Asia/Almaty
# Only for pytest (database is wiped by the tests!)
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/wms_test
# Sign-up confirmation codes. Without any of these the code is only printed in the server log (fine locally).
# Render free blocks SMTP ports, so there use Brevo (free 300 emails/day, HTTP API): https://app.brevo.com -> SMTP & API -> API keys
EMAIL_FROM=KeyFive WMS <your-verified-sender@gmail.com>
BREVO_API_KEY=
# Or plain SMTP (e.g. Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
